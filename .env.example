# ====  COMO USAR  ========================================================================
# --   Copie esse arquivo e o renomeie para '.env', depois adicione suas credenciais     --
# =========================================================================================

# Variáveis de ambiente mysql
DB_HOST='' # Id da máquina de acesso
DB_USER='' # Nome do usuário de acesso
DB_PASSWORD='' # Senha do usuário de acesso
DB_NAME='' # Nome do BD

# Variáveis de ambiente AWS
AWS_ACESS_KEY_ID= # Acess key da aws cli
AWS_SECRET_KEY= # Secret key da aws cli
AWS_SESSION_TOKEN= # Session key da aws cli


# Copie para .env e preencha as credenciais do ambiente de captura.
# Não use nem versione credenciais reais.

# Alvo padrão público para validar a sonda. Prefira endpoint de staging próprio
# para medir a capacidade da aplicação InfraWatch.
INFRAWATCH_REQUEST_PROBE_URL=https://httpbin.org/post
INFRAWATCH_REQUEST_PROBE_METHOD=POST
INFRAWATCH_REQUEST_PROBE_TIMEOUT=3
INFRAWATCH_REQUEST_PROBE_ENABLED=true
# ====  IMPORTANTE  =======================================================================
# -- NÃO COMITE SEU ARQUIVO .ENV (Isso pode acarretar na perca da sua conta AWS student) --
# =========================================================================================